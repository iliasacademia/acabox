<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Required for Electron apps -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Required for Apple Events / AppleScript automation -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Network access -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Voice dictation. Under hardened runtime the microphone is unreachable
         without audio-input, and on-device transcription without
         speech-recognition, regardless of the Info.plist usage strings. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.speech-recognition</key>
    <true/>
</dict>
</plist>
